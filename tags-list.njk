<h1>Tags</h1>

{% for tag in collections.tagList %}
  {% set tagUrl %}/tags/{{ tag }}/{% endset %}
  <a href="{{ tagUrl | url }}" class="inline-block uppercase align-text-top text-secondary visited:text-secondary border border-secondary text-xs px-2 py-0.5 ml-3 rounded-full">{{ tag }}</a>
{% endfor %}
