{#
  Renders a project's hero media at 16:10: a muted looping video for .mp4/.webm,
  an image for anything else, or a placeholder box until real media exists.
  `src` can be a single path or a list of video sources in order of preference
  (e.g. [/media/x.webm, /media/x.mp4]); the browser plays the first it supports.
  Images get a srcset from any `<name>-<width>w` variants beside them; pass `sizes`
  for how wide the image renders, and `eager=true` when it is above the fold.
  For an animated image, pass `still` (a single frame) to show instead when the
  visitor prefers reduced motion – browsers don't pause animated images on their own.
#}
{% macro projectMedia(src, alt, label, zoomOnHover=false, sizes="100vw", eager=false, still="") %}
<div class="aspect-[16/10] overflow-hidden rounded-md bg-bg-dark">
  {%- set mediaClass = "w-full h-full object-cover" + (" motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:scale-[1.02] motion-safe:group-focus-visible:scale-[1.02]" if zoomOnHover else "") -%}
  {%- set sources = [src] if src is string else src -%}
  {%- set first = sources[0] if sources else "" -%}
  {%- if first and (first.endsWith('.mp4') or first.endsWith('.webm')) %}
  <video class="{{ mediaClass }}" autoplay muted loop playsinline {% if alt %}aria-label="{{ alt }}"{% else %}aria-hidden="true"{% endif %}>
    {%- for source in sources %}
    <source src="{{ source | url }}" type="video/{{ 'webm' if source.endsWith('.webm') else 'mp4' }}">
    {%- endfor %}
  </video>
  {%- elif first %}
  {%- set srcset = first | srcset %}
  {%- if still %}<picture class="contents"><source media="(prefers-reduced-motion: reduce)" srcset="{{ still | url }}">{% endif %}
  <img class="{{ mediaClass }}" src="{{ first | url }}"{% if srcset %} srcset="{{ srcset }}" sizes="{{ sizes }}"{% endif %} alt="{{ alt }}" {% if eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
  {%- if still %}</picture>{% endif %}
  {%- else %}
  <div class="w-full h-full flex items-center justify-center p-4 border border-divider rounded-md text-muted text-sm text-center" role="img" aria-label="{{ label }} – media coming soon">
    {{ label }}<br>media coming soon
  </div>
  {%- endif %}
</div>
{% endmacro %}
