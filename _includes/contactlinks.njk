{% macro externalLink(href, label) %}
<a href="{{ href }}" rel="me noopener" target="_blank" class="link-underline inline-flex items-center gap-1">
  {{- label -}}
  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
  <span class="sr-only">(opens in a new tab)</span>
</a>
{% endmacro %}
<ul class="flex flex-wrap gap-x-6 gap-y-2 font-headline">
  <li><a href="mailto:{{ metadata.author.email }}" class="link-underline">Email</a></li>
  <li>{{ externalLink(metadata.author.linkedin, "LinkedIn") }}</li>
  <li>{{ externalLink(metadata.author.github, "GitHub") }}</li>
  <li><a href="{{ metadata.resume | url }}" class="link-underline">Resume (PDF)</a></li>
</ul>
