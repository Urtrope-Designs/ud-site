{% from "projectmedia.njk" import projectMedia %}
<ul class="grid grid-cols-1 tablet:grid-cols-2 gap-8 max-w-[1100px]">
{% for project in projectslist %}
  <li>
    <a href="{{ project.url | url }}" class="group block h-full p-4 rounded-lg bg-bg-dark text-text visited:text-text motion-safe:transition-transform motion-safe:duration-200 hover:-translate-y-1 focus-visible:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
      {{ projectMedia(project.data.hero, project.data.heroAlt, project.data.title, true) }}
      <h2 class="font-headline font-bold text-xl mt-4 group-hover:underline">{{ project.data.title }}</h2>
      {% if project.data.summary %}<p class="mt-1">{{ project.data.summary }}</p>{% endif %}
      {% if project.data.tools %}
      <ul class="flex flex-wrap gap-2 mt-3" aria-label="Built with">
        {%- for tool in project.data.tools | head(3) %}
        <li class="text-xs text-secondary border border-secondary rounded-full px-2 py-0.5">{{ tool }}</li>
        {%- endfor %}
      </ul>
      {% endif %}
    </a>
  </li>
{% endfor %}
</ul>
