{
  "name": "urtrope-designs-site",
  "version": "1.0.0",
  "description": "A static site for showcasing my dev work",
  "scripts": {
    "watch": "npx eleventy --watch",
    "debug": "DEBUG=* npx eleventy",
    "clean": "rimraf _site",
    "serve:eleventy": "npx eleventy --serve --watch",
    "start": "run-s clean serve:eleventy",
    "build:eleventy": "npx eleventy",
    "build": "export NODE_ENV=production || SET \"NODE_ENV=production\" && run-s clean build:*"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/Urtrope-Designs/ud-site.git"
  },
  "author": {
    "name": "Sean Cunningham",
    "email": "scunningham77@proton.me",
    "url": "https://urtropedesigns.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Urtrope-Designs/ud-site/issues"
  },
  "homepage": "https://urtropedesigns.com/",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.2",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.2.0",
    "@tailwindcss/typography": "^0.5.8",
    "autoprefixer": "^10.4.13",
    "luxon": "^3.1.0",
    "markdown-it": "^13.0.1",
    "markdown-it-anchor": "^8.6.5",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.19",
    "rimraf": "^3.0.2",
    "tailwindcss": "^3.2.4"
  }
}
